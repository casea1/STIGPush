<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles the same core source files that are built into StigGpoManager.exe, so the
       AD-independent logic is tested exactly as shipped. Runs on Windows or Linux. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>10</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>StigGpoManager.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\Core\**\*.cs" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\config.sample.json" Link="config.sample.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
