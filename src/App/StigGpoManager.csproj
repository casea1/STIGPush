<Project Sdk="Microsoft.NET.Sdk">
  <!-- Single-file StigGpoManager.exe for .NET Framework 4.8 (in-box on Windows Server 2025 / Windows 11).
       No third-party runtime dependencies: System.Management.Automation (PowerShell 5.1), WPF and
       WinForms are resolved from the Windows GAC. NuGet packages below are build-time reference
       assemblies only. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>10</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>StigGpoManager</AssemblyName>
    <RootNamespace>StigGpoManager</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>STIG GPO Manager</Product>
    <Company>Site ISSO / Systems Administration</Company>
    <Description>Quarterly import of DISA STIG GPOs into Active Directory</Description>
    <Copyright>Internal use</Copyright>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <DebugType>embedded</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Core\**\*.cs" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\config.sample.json" Link="Resources\config.sample.json" LogicalName="StigGpoManager.config.sample.json" />
    <Resource Include="Resources\app.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.PowerShell.5.1.ReferenceAssemblies" Version="1.0.0" PrivateAssets="all" ExcludeAssets="runtime" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Security" />
    <Reference Include="System.DirectoryServices" />
  </ItemGroup>
</Project>
