<Window x:Class="StigGpoManager.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="STIG GPO Manager - Setup" Height="760" Width="1180" MinWidth="820" MinHeight="560"
        Icon="Resources/app.ico" WindowStartupLocation="CenterOwner" FontSize="12">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="MinHeight" Value="26"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,2"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF555555"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="Detected" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF1F6E2E"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border x:Name="SetupHeader" DockPanel.Dock="Top" Background="#FF1F4E8C" Padding="12,8">
            <StackPanel>
                <TextBlock Text="Setup" Foreground="White" FontSize="18" FontWeight="Bold"/>
                <TextBlock x:Name="SetupSubtitle" Foreground="#FFDCE6F5" TextWrapping="Wrap"
                           Text="Values are detected from this domain where possible. Check each page, change anything that is wrong, then save. Nothing in Active Directory is changed by setup."/>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="#FFEDEDED" BorderBrush="#FFCCCCCC" BorderThickness="0,1,0,0" Padding="10,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="BackButton" Content="&lt; Back" Width="90" Click="Back_Click"/>
                    <Button x:Name="NextButton" Content="Next &gt;" Width="90" Click="Next_Click"/>
                    <Button x:Name="SaveButton" Content="Save config" Width="110" FontWeight="Bold" Background="#FFF2D7A6" Click="Save_Click"/>
                    <Button Content="Cancel" Width="80" IsCancel="True"/>
                </StackPanel>
                <ProgressBar x:Name="SetupBusy" Width="120" Height="12" Margin="0,0,10,0" Visibility="Hidden" DockPanel.Dock="Left"/>
                <TextBlock x:Name="SetupStatus" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <TabControl x:Name="Pages" Margin="10" SelectionChanged="Pages_SelectionChanged">
            <!-- 1. DOMAIN -->
            <TabItem Header="1. Domain">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource Label}" Text="Domain (DNS name)"/>
                        <TextBox x:Name="DomainBox" Width="420" HorizontalAlignment="Left" TextChanged="Field_Changed"/>
                        <TextBlock x:Name="DomainDetected" Style="{StaticResource Detected}"/>
                        <TextBlock Style="{StaticResource Hint}" Text="Every target OU must be inside this domain, so a lab config can never be run against production and vice versa."/>

                        <TextBlock Style="{StaticResource Label}" Text="Domain controller for all changes"/>
                        <ComboBox x:Name="DcBox" Width="420" HorizontalAlignment="Left" IsEditable="True"/>
                        <TextBlock Style="{StaticResource Hint}" Text="auto-pdc (recommended) resolves the PDC emulator each time the tool starts and sends every GroupPolicy/AD call to it."/>

                        <TextBlock Style="{StaticResource Label}" Text="Central Store"/>
                        <TextBlock x:Name="StoreDetected" Style="{StaticResource Detected}"/>
                        <CheckBox x:Name="StoreOverrideCheck" Content="Use a different Central Store path" Margin="0,4,0,0" Checked="StoreOverride_Changed" Unchecked="StoreOverride_Changed"/>
                        <TextBox x:Name="StoreBox" Width="620" HorizontalAlignment="Left" IsEnabled="False" Margin="0,4,0,0"/>

                        <TextBlock Style="{StaticResource Label}" Text="ADML language"/>
                        <TextBox x:Name="LanguageBox" Width="120" HorizontalAlignment="Left"/>

                        <TextBlock Style="{StaticResource Label}" Text="Detected"/>
                        <TextBlock x:Name="DomainFacts" Style="{StaticResource Hint}"/>
                        <ItemsControl x:Name="NotesList" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding}" Foreground="SaddleBrown" TextWrapping="Wrap" Margin="0,1"/></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 2. NAMING & FOLDERS -->
            <TabItem Header="2. Naming and folders">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource Label}" Text="Exception GPO prefix"/>
                        <ComboBox x:Name="ExceptionPrefixBox" Width="300" HorizontalAlignment="Left" IsEditable="True" FontFamily="Consolas"/>
                        <TextBlock x:Name="ExceptionPrefixHint" Style="{StaticResource Detected}"/>
                        <TextBlock Style="{StaticResource Hint}" Text="Site exception GPOs are identified by this name prefix (include any trailing space, e.g. &quot;SITE - &quot;). They always win: the tool keeps them above every DISA GPO on every OU."/>

                        <TextBlock Style="{StaticResource Label}" Text="DISA GPO prefix"/>
                        <TextBox x:Name="DisaPrefixBox" Width="300" HorizontalAlignment="Left" FontFamily="Consolas"/>

                        <TextBlock Style="{StaticResource Label}" Text="Pilot group (for group-based pilot)"/>
                        <ComboBox x:Name="PilotGroupBox" Width="300" HorizontalAlignment="Left" IsEditable="True"/>
                        <TextBlock x:Name="PilotGroupHint" Style="{StaticResource Hint}"/>

                        <TextBlock Style="{StaticResource Label}" Text="Working folder"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="WorkingBox" Width="520"/>
                            <Button Content="Browse..." Margin="6,0,0,0" Click="BrowseWorking_Click"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="Run state, backups, reports, the exceptions register and the append-only audit log live here. It does not replicate: include it in this server's backups, or use a UNC path to an admin-only share."/>

                        <TextBlock Style="{StaticResource Label}" Text="Pilot soak (days)"/>
                        <TextBox x:Name="SoakBox" Width="80" HorizontalAlignment="Left"/>

                        <CheckBox x:Name="GateCheck" Content="Block Promote until pilot scan results are imported and every open finding is in the exceptions register (recommended)" Margin="0,12,0,0"/>
                        <CheckBox x:Name="CommentCheck" Content="Write package, version and import date into each new GPO's comment" Margin="0,6,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 3. MAPPINGS -->
            <TabItem Header="3. GPO mappings">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                                   Text="One row per DISA GPO you deploy. Rows were proposed from DISA GPOs currently linked in this domain: the name pattern from the GPO name, production OUs from its links, pilot OUs from a 'Pilot' child OU. 'Match' is a regex against the DISA backup's display name. Load the DISA package to check which backup each row matches."/>
                        <StackPanel Orientation="Horizontal" Margin="0,6">
                            <Button Content="Load DISA package to preview matches..." Click="LoadPackage_Click"/>
                            <Button Content="Add mapping" Click="AddMapping_Click"/>
                            <Button Content="Remove selected" Click="RemoveMapping_Click"/>
                            <Button Content="Pick production OUs..." Click="PickProd_Click"/>
                            <Button Content="Pick pilot OUs..." Click="PickPilot_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="PackageText" Style="{StaticResource Hint}"/>
                    </StackPanel>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DataGrid x:Name="MappingsGrid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#FFDDDDDD" SelectionMode="Single">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Include}" Value="False"><Setter Property="Foreground" Value="#FF888888"/></DataTrigger>
                                        <DataTrigger Binding="{Binding HasProblem}" Value="True"><Setter Property="Background" Value="#FFFFF3CD"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Use" Binding="{Binding Include, UpdateSourceTrigger=PropertyChanged}" Width="40"/>
                                <DataGridTextColumn Header="New GPO name pattern" Binding="{Binding NameTemplate, UpdateSourceTrigger=LostFocus}" Width="1.6*"/>
                                <DataGridTextColumn Header="Match (regex on DISA backup name)" Binding="{Binding Match, UpdateSourceTrigger=LostFocus}" Width="1.8*">
                                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Consolas"/></Style></DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Production OUs (; separated)" Binding="{Binding ProdText, UpdateSourceTrigger=LostFocus}" Width="2*"/>
                                <DataGridTextColumn Header="Pilot OUs" Binding="{Binding PilotText, UpdateSourceTrigger=LostFocus}" Width="1.5*"/>
                                <DataGridComboBoxColumn x:Name="ModeColumn" Header="Pilot" SelectedItemBinding="{Binding Mode, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                <DataGridTextColumn Header="Matches in package" Binding="{Binding Preview}" IsReadOnly="True" Width="1.4*"/>
                                <DataGridTextColumn Header="Why proposed / problem" Binding="{Binding Note}" IsReadOnly="True" Width="1.4*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="1" Text="Backups in the package that no mapping matches (they will be skipped):" FontWeight="SemiBold" Margin="0,8,0,2"/>
                        <DockPanel Grid.Row="2">
                            <Button DockPanel.Dock="Right" Content="Add mapping for selected backup" VerticalAlignment="Top" Click="AddFromBackup_Click"/>
                            <ListBox x:Name="UnmatchedList" Height="90" Margin="0,0,6,0"/>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- 4. REVIEW -->
            <TabItem Header="4. Review and save">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock x:Name="SavePathText" Style="{StaticResource Hint}"/>
                        <ItemsControl x:Name="IssuesList" Margin="0,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" TextWrapping="Wrap" Margin="0,1"/></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="config.json that will be written:" FontWeight="SemiBold" Margin="0,6,0,2"/>
                    </StackPanel>
                    <TextBox x:Name="JsonPreview" IsReadOnly="True" FontFamily="Consolas" FontSize="11" VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
