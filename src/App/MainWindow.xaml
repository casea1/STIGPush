<Window x:Class="StigGpoManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:StigGpoManager"
        Title="STIG GPO Manager" Height="900" Width="1400" MinWidth="1000" MinHeight="650"
        Icon="Resources/app.ico" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13" Background="{StaticResource AppBackground}" Foreground="{StaticResource Ink}">
    <Window.Resources>
        <Style x:Key="SeverityRow" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="1"><Setter Property="Background" Value="{StaticResource WarnSoft}"/></DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="2"><Setter Property="Background" Value="{StaticResource DangerSoft}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusRow" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Fail"><Setter Property="Background" Value="{StaticResource DangerSoft}"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Warning"><Setter Property="Background" Value="{StaticResource WarnSoft}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BackupRow" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsUnmatched}" Value="True"><Setter Property="Background" Value="{StaticResource DangerSoft}"/></DataTrigger>
                <DataTrigger Binding="{Binding Skip}" Value="True"><Setter Property="Foreground" Value="#FF8A94A3"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFCBD5E1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="Big" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Header: app, domain, tools, new update -->
        <Border x:Name="HeaderBorder" DockPanel.Dock="Top" Background="{StaticResource HeaderBg}" Padding="16,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Resources/app.ico" Width="24" Height="24" Margin="0,0,10,0"/>
                    <TextBlock Text="STIG GPO Manager" Foreground="White" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="HeaderText" Foreground="#FF94A3B8" Margin="18,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource NavButton}" Content="Home" Click="NavHome_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="Exceptions" Click="NavRegister_Click" ToolTip="Exceptions register (accepted deviations used by the scan gate)"/>
                    <Button Style="{StaticResource NavButton}" Content="Audit log" Click="NavAudit_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="Health" Click="NavHealth_Click" ToolTip="Pre-flight checks and setup"/>
                    <Button x:Name="NewUpdateButton" Style="{StaticResource PrimaryButton}" Content="+ New quarterly update" Click="NewUpdate_Click" Margin="10,0,0,0"/>
                </StackPanel>
                <Grid/>
            </DockPanel>
        </Border>

        <!-- Status bar with a collapsible activity log -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="12,4">
                    <ToggleButton x:Name="LogToggle" DockPanel.Dock="Right" Content="Activity log" Padding="10,2" Checked="LogToggle_Changed" Unchecked="LogToggle_Changed"/>
                    <CheckBox x:Name="ShowCommands" DockPanel.Dock="Right" Content="Show cmdlets" Margin="0,0,12,0" Visibility="Collapsed"/>
                    <ProgressBar x:Name="Busy" DockPanel.Dock="Right" Width="140" Height="6" Margin="0,0,12,0" Visibility="Hidden" Foreground="{StaticResource Accent}"/>
                    <TextBlock x:Name="StatusText" Text="Ready" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                </DockPanel>
                <ListBox x:Name="LogList" Height="150" Visibility="Collapsed" FontFamily="Consolas" FontSize="11" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Line}">
                    <ListBox.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding Text}" Foreground="{Binding Brush}"/></DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid x:Name="Views" Margin="18,14,18,12">

            <!-- ============================ HOME ============================ -->
            <DockPanel x:Name="HomeView">
                <Border DockPanel.Dock="Top" Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <TextBlock x:Name="NextReleaseText" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Quarterly GPO updates"/>
                        </DockPanel>
                        <local:TimelineView x:Name="Calendar"/>
                    </DockPanel>
                </Border>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- current update -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Current update"/>
                            <TextBlock x:Name="CurrentTitle" Style="{StaticResource Big}" Text="No update in progress"/>
                            <TextBlock x:Name="CurrentStatus" Foreground="{StaticResource Muted}" Margin="0,2,0,14" TextWrapping="Wrap"
                                       Text="When DISA's next GPO package has been transferred in, click New quarterly update."/>
                            <ItemsControl x:Name="MiniStepper" Margin="0,0,0,16">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                            <Border Width="24" Height="24" CornerRadius="12" Background="{Binding Fill}" BorderBrush="{Binding Stroke}" BorderThickness="1.5">
                                                <TextBlock Text="{Binding Badge}" Foreground="{Binding BadgeInk}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" Margin="6,0,0,0" VerticalAlignment="Center" FontWeight="{Binding Weight}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ContinueButton" Style="{StaticResource PrimaryButton}" Content="Continue" Click="Continue_Click" MinWidth="240" Padding="18,8" FontSize="14"/>
                                <Button x:Name="CurrentReportButton" Content="Run report" Click="CurrentReport_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <!-- health and history -->
                    <DockPanel Grid.Column="2">
                        <Border DockPanel.Dock="Top" x:Name="HealthCard" Style="{StaticResource CardBorder}" Margin="0,0,0,12" Cursor="Hand" MouseLeftButtonUp="HealthCard_Click">
                            <DockPanel>
                                <Border x:Name="HealthDot" DockPanel.Dock="Left" Width="12" Height="12" CornerRadius="6" Background="{StaticResource Muted}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock x:Name="HealthTitle" FontWeight="SemiBold" Text="Checking the domain ..."/>
                                    <TextBlock x:Name="HealthDetail" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardTitle}" Text="History"/>
                                <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                    <Button Content="Open" Click="HistoryOpen_Click" Margin="0,0,6,4"/>
                                    <Button Content="Report" Click="HistoryReport_Click" Margin="0,0,6,4"/>
                                    <Button Content="Roll back..." Click="HistoryRollback_Click" Margin="0,0,6,4"/>
                                    <Button Content="Close" Click="HistoryClose_Click" Margin="0,0,6,4" ToolTip="Mark the update finished (kept for audit)"/>
                                    <Button x:Name="CleanupButton" Content="Clean up old versions..." Click="NavCleanup_Click" Margin="0,0,0,4"/>
                                </WrapPanel>
                                <DataGrid x:Name="HistoryGrid" IsReadOnly="True" SelectionMode="Single" MouseDoubleClick="HistoryOpen_Click" MinHeight="100">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Release" Binding="{Binding Release}" Width="125"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                                        <DataGridTextColumn Header="GPOs" Binding="{Binding Items}" Width="50"/>
                                        <DataGridTextColumn Header="Started" Binding="{Binding Created}" Width="95"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </DockPanel>
                </Grid>
            </DockPanel>

            <!-- ============================ UPDATE (4 stages) ============================ -->
            <DockPanel x:Name="UpdateView" Visibility="Collapsed">
                <Border DockPanel.Dock="Top" Style="{StaticResource CardBorder}" Margin="0,0,0,12" Padding="14,10">
                    <DockPanel>
                        <Button DockPanel.Dock="Left" Content="&#x2190; Home" Click="NavHome_Click" VerticalAlignment="Center"/>
                        <Button x:Name="RollbackButton" DockPanel.Dock="Right" Content="Roll back this update..." Click="UpdateRollback_Click" VerticalAlignment="Center" Margin="0"/>
                        <StackPanel Margin="8,0,0,0">
                            <TextBlock x:Name="UpdateTitle" FontSize="18" FontWeight="SemiBold" Text="New quarterly update"/>
                            <ItemsControl x:Name="Stepper" Margin="0,6,0,0">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Click="Stage_Click" Tag="{Binding Index}" Background="Transparent" BorderThickness="0" Padding="2" Margin="0,0,18,0" MinHeight="26">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="24" Height="24" CornerRadius="12" Background="{Binding Fill}" BorderBrush="{Binding Stroke}" BorderThickness="1.5">
                                                    <TextBlock Text="{Binding Badge}" Foreground="{Binding BadgeInk}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" Margin="6,0,0,0" VerticalAlignment="Center" FontWeight="{Binding Weight}" TextDecorations="{Binding Underline}"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- explanation of the stage -->
                <Border DockPanel.Dock="Top" Style="{StaticResource CardBorder}" Margin="0,0,0,12" Padding="14,10">
                    <DockPanel>
                        <Border x:Name="ChangesPill" DockPanel.Dock="Right" CornerRadius="10" Padding="10,3" VerticalAlignment="Top" Background="{StaticResource SuccessSoft}">
                            <TextBlock x:Name="ChangesPillText" FontSize="12" FontWeight="SemiBold" Text="No AD changes"/>
                        </Border>
                        <StackPanel>
                            <TextBlock x:Name="StageHeading" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock x:Name="StageExplain" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,12,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- the one thing to do on this stage -->
                <Border DockPanel.Dock="Bottom" Style="{StaticResource CardBorder}" Margin="0,12,0,0" Padding="12,8">
                    <DockPanel>
                        <Button x:Name="PrimaryAction" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Do it" Click="PrimaryAction_Click" MinWidth="240" Padding="18,8" FontSize="14" Margin="0"/>
                        <TextBlock x:Name="PrimaryHint" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,12,0"/>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <Grid x:Name="StagePanels">

                        <!-- 1. PREPARE -->
                        <DockPanel x:Name="PreparePanel">
                            <Border x:Name="ZipDrop" DockPanel.Dock="Top" Style="{StaticResource DropZone}" Drop="ZipDrop_Drop" DragOver="Drop_DragOver">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Browse..." Click="BrowseZip_Click" Margin="0"/>
                                    <StackPanel>
                                        <TextBlock Text="Drop DISA's GPO package (.zip) here" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock x:Name="ZipPathText" Text="The tool reads it, shows its SHA-256 and finds every GPO inside. Nothing changes yet." Foreground="{StaticResource Muted}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <TextBlock Text="Expected SHA-256 (optional): " VerticalAlignment="Center"/>
                                <TextBox x:Name="ExpectedHashBox" FontFamily="Consolas"/>
                            </DockPanel>
                            <TextBlock x:Name="HashText" DockPanel.Dock="Top" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <TextBlock x:Name="StoreSummary" DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="Use suggested mappings for red rows" Click="UseSuggestions_Click"/>
                                <Button Content="Edit mappings..." Click="Setup_Click"/>
                                <Button Content="Central Store details..." Click="StoreDetails_Click"/>
                            </StackPanel>
                            <DataGrid x:Name="BackupsGrid" RowStyle="{StaticResource BackupRow}" SelectionMode="Single" MinHeight="120">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="Skip" Binding="{Binding Skip, UpdateSourceTrigger=PropertyChanged}" Width="45"/>
                                    <DataGridTextColumn Header="GPO in the DISA package" Binding="{Binding DisplayName}" IsReadOnly="True" Width="2*"/>
                                    <DataGridTextColumn Header="Version" Binding="{Binding Version, UpdateSourceTrigger=LostFocus}" Width="65"/>
                                    <DataGridComboBoxColumn x:Name="MappingColumn" Header="Mapping" SelectedItemBinding="{Binding Mapping, UpdateSourceTrigger=PropertyChanged}" Width="1.6*"/>
                                    <DataGridTextColumn Header="Will be created as" Binding="{Binding ProposedName}" IsReadOnly="True" Width="1.6*"/>
                                    <DataGridTextColumn Header="Note" Binding="{Binding Problem}" IsReadOnly="True" Width="1.6*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>

                        <!-- 2. REVIEW -->
                        <DockPanel x:Name="ReviewPanel" Visibility="Collapsed">
                            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <Border x:Name="ChipAttention" CornerRadius="12" Padding="12,4" Margin="0,0,8,4" Background="{StaticResource DangerSoft}"><TextBlock x:Name="ChipAttentionText" FontWeight="SemiBold"/></Border>
                                <Border CornerRadius="12" Padding="12,4" Margin="0,0,8,4" Background="#FFF1F5F9"><TextBlock x:Name="ChipChanges"/></Border>
                                <CheckBox x:Name="ShowAllChanges" Content="Show all changes" Margin="8,0,0,4" Checked="ReviewFilter_Changed" Unchecked="ReviewFilter_Changed"/>
                                <Button Content="Open full report" Click="OpenReviewReport_Click" Margin="12,0,8,4"/>
                                <Button Content="Run review again" Click="Review_Click" Margin="0,0,0,4"/>
                            </WrapPanel>
                            <ScrollViewer DockPanel.Dock="Top" MaxHeight="70" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="ReviewWarnings">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding}" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="0,1"/></DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <DataGrid x:Name="ReviewGrid" IsReadOnly="True" RowStyle="{StaticResource SeverityRow}" MinHeight="120">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="What" Binding="{Binding Flag}" Width="1.4*"/>
                                    <DataGridTextColumn Header="Setting" Binding="{Binding Setting}" Width="2*"/>
                                    <DataGridTextColumn Header="Change" Binding="{Binding Change}" Width="75"/>
                                    <DataGridTextColumn Header="Was" Binding="{Binding OldValue}" Width="1.2*"/>
                                    <DataGridTextColumn Header="Now" Binding="{Binding NewValue}" Width="1.2*"/>
                                    <DataGridTextColumn Header="Exception GPO" Binding="{Binding ExceptionGpo}" Width="1.1*"/>
                                    <DataGridTextColumn Header="Details" Binding="{Binding Detail}" Width="2*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>

                        <!-- 3. PILOT -->
                        <DockPanel x:Name="PilotPanel" Visibility="Collapsed">
                            <Grid DockPanel.Dock="Top" x:Name="SoakCard" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0">
                                    <TextBlock x:Name="SoakDayText" Style="{StaticResource Big}" Text="Not started"/>
                                    <TextBlock x:Name="SoakEndText" Foreground="{StaticResource Muted}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <ProgressBar x:Name="SoakBar" Height="10" Maximum="14" Foreground="{StaticResource Accent}" Background="#FFE5E7EB" BorderThickness="0"/>
                                    <TextBlock x:Name="GateText" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                            <Border DockPanel.Dock="Top" x:Name="ScanDrop" Style="{StaticResource DropZone}" Drop="ScanDrop_Drop" DragOver="Drop_DragOver" Padding="14,8">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <RadioButton x:Name="StagePilot" Content="Pilot results" IsChecked="True" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <RadioButton x:Name="StageBaseline" Content="Before pilot (baseline)" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Button Content="Browse..." Click="BrowseScan_Click" Margin="0"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Drop SCC / Evaluate-STIG results from pilot machines here" FontWeight="SemiBold"/>
                                        <TextBlock Text=".ckl, .cklb or XCCDF .xml. Open findings that are not in the exceptions register block Promote." Foreground="{StaticResource Muted}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="Add selected findings to exceptions..." Click="AddToRegister_Click"/>
                            </StackPanel>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <DataGrid x:Name="PilotGrid" IsReadOnly="True" MinHeight="90">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="New GPO" Binding="{Binding Name}" Width="1.6*"/>
                                        <DataGridTextColumn Header="Pilot" Binding="{Binding PilotTargets}" Width="2.4*"/>
                                        <DataGridTextColumn Header="Replaces" Binding="{Binding Previous}" Width="1.4*"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <DataGrid x:Name="FindingsGrid" Grid.Row="1" IsReadOnly="True" RowStyle="{StaticResource SeverityRow}" MinHeight="90">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="85"/>
                                        <DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="120"/>
                                        <DataGridTextColumn Header="V-ID" Binding="{Binding VulnId}" Width="85"/>
                                        <DataGridTextColumn Header="Finding" Binding="{Binding Title}" Width="3*"/>
                                        <DataGridTextColumn Header="Exception / POA&amp;M" Binding="{Binding Exception}" Width="1.5*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </DockPanel>

                        <!-- 4. PROMOTE -->
                        <DockPanel x:Name="PromotePanel" Visibility="Collapsed">
                            <Border DockPanel.Dock="Top" x:Name="PromoteGateBorder" CornerRadius="6" Padding="10,6" Margin="0,0,0,8" Background="#FFF1F5F9">
                                <TextBlock x:Name="PromoteGateText" TextWrapping="Wrap" FontWeight="SemiBold"/>
                            </Border>
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                <DockPanel Margin="0,0,0,4">
                                    <Button DockPanel.Dock="Right" x:Name="RefreshButton" Content="Refresh policy on these computers..." Click="PushRefresh_Click" Margin="0"/>
                                    <TextBlock Text="Policy refresh (after promote)" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </DockPanel>
                                <DataGrid x:Name="RefreshGrid" IsReadOnly="True" Height="130">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Computer" Binding="{Binding Computer}" Width="260"/>
                                        <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="90"/>
                                        <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                            <DataGrid x:Name="PromoteGrid" IsReadOnly="True" MinHeight="90">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="New GPO" Binding="{Binding Name}" Width="1.6*"/>
                                    <DataGridTextColumn Header="Production OUs" Binding="{Binding ProdTargets}" Width="2.6*"/>
                                    <DataGridTextColumn Header="Old version (disabled, kept)" Binding="{Binding Previous}" Width="1.6*"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>

                        <!-- DONE -->
                        <StackPanel x:Name="DonePanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="&#x2713;" FontSize="48" Foreground="{StaticResource Success}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="DoneText" Style="{StaticResource Big}" HorizontalAlignment="Center" Text="This update is in production"/>
                            <TextBlock x:Name="DoneDetail" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="620" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </DockPanel>

            <!-- ============================ TOOLS ============================ -->
            <Border x:Name="RegisterView" Visibility="Collapsed" Style="{StaticResource CardBorder}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Style="{StaticResource CardTitle}" Text="Exceptions register"/>
                        <TextBlock Style="{StaticResource Hint}" Text="Accepted deviations. Open scan findings listed here do not block Promote. Every entry needs a justification; record the POA&amp;M or risk acceptance. Leave STIG empty to match the V-ID in any STIG."/>
                        <TextBlock x:Name="RegisterPathText" Style="{StaticResource Hint}"/>
                        <StackPanel Style="{StaticResource Toolbar}">
                            <Button Content="Add row" Click="RegisterAdd_Click"/>
                            <Button Content="Delete selected" Click="RegisterDelete_Click"/>
                            <Button Content="Reload" Click="RegisterReload_Click"/>
                            <Button Content="Save" Style="{StaticResource PrimaryButton}" Click="RegisterSave_Click"/>
                        </StackPanel>
                    </StackPanel>
                    <DataGrid x:Name="RegisterGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="V-ID" Binding="{Binding VulnId}" Width="90"/>
                            <DataGridTextColumn Header="STIG" Binding="{Binding StigName}" Width="1.5*"/>
                            <DataGridTextColumn Header="Exception GPO" Binding="{Binding ExceptionGpo}" Width="1.5*"/>
                            <DataGridTextColumn Header="Justification" Binding="{Binding Justification}" Width="3*"/>
                            <DataGridTextColumn Header="POA&amp;M / risk acceptance" Binding="{Binding PoamReference}" Width="*"/>
                            <DataGridTextColumn Header="Added" Binding="{Binding DateAdded, StringFormat=yyyy-MM-dd}" IsReadOnly="True" Width="85"/>
                            <DataGridTextColumn Header="By" Binding="{Binding AddedBy}" IsReadOnly="True" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border x:Name="AuditView" Visibility="Collapsed" Style="{StaticResource CardBorder}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Style="{StaticResource CardTitle}" Text="Audit log"/>
                        <TextBlock x:Name="AuditPathText" Style="{StaticResource Hint}"/>
                        <StackPanel Style="{StaticResource Toolbar}">
                            <Button Content="Refresh" Click="AuditRefresh_Click"/>
                            <CheckBox x:Name="AuditCurrentRun" Content="Current update only" Checked="AuditRefresh_Click" Unchecked="AuditRefresh_Click"/>
                        </StackPanel>
                    </StackPanel>
                    <DataGrid x:Name="AuditGrid" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time (UTC)" Binding="{Binding Time}" Width="170"/>
                            <DataGridTextColumn Header="User" Binding="{Binding User}" Width="130"/>
                            <DataGridTextColumn Header="Update" Binding="{Binding Run}" Width="160"/>
                            <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="130"/>
                            <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="2*"/>
                            <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="80"/>
                            <DataGridTextColumn Header="Error / detail" Binding="{Binding Error}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border x:Name="HealthView" Visibility="Collapsed" Style="{StaticResource CardBorder}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Style="{StaticResource CardTitle}" Text="Health and setup"/>
                        <TextBlock x:Name="ConfigPathText" Style="{StaticResource Hint}"/>
                        <StackPanel Style="{StaticResource Toolbar}">
                            <Button Content="Run checks" Style="{StaticResource PrimaryButton}" Click="Preflight_Click"/>
                            <CheckBox x:Name="DcDiagCheck" Content="Include dcdiag (SYSVOL / replication)" IsChecked="True" Margin="0,0,12,0"/>
                            <Button Content="Setup wizard..." Click="Setup_Click"/>
                            <Button Content="Open config" Click="OpenConfig_Click"/>
                            <Button Content="Open working folder" Click="OpenWorking_Click"/>
                        </StackPanel>
                    </StackPanel>
                    <DataGrid x:Name="PreflightGrid" IsReadOnly="True" RowStyle="{StaticResource StatusRow}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                            <DataGridTextColumn Header="Check" Binding="{Binding Name}" Width="230"/>
                            <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border x:Name="CleanupView" Visibility="Collapsed" Style="{StaticResource CardBorder}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Style="{StaticResource CardTitle}" Text="Clean up old versions"/>
                        <TextBlock Style="{StaticResource Hint}" Text="DISA GPOs two or more versions older than the newest, with no enabled links. The newest version and the one before it (your rollback) are always kept. Each GPO is backed up, then deleted. Requires typing DELETE."/>
                        <StackPanel Style="{StaticResource Toolbar}">
                            <Button Content="Find old versions" Click="FindCleanup_Click"/>
                            <Button Content="Delete selected..." Style="{StaticResource PrimaryButton}" Click="PushCleanup_Click"/>
                        </StackPanel>
                    </StackPanel>
                    <DataGrid x:Name="CleanupGrid">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Delete" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                            <DataGridTextColumn Header="GPO" Binding="{Binding Name}" IsReadOnly="True" Width="2*"/>
                            <DataGridTextColumn Header="Version" Binding="{Binding Version}" IsReadOnly="True" Width="70"/>
                            <DataGridTextColumn Header="Newest" Binding="{Binding Latest}" IsReadOnly="True" Width="70"/>
                            <DataGridTextColumn Header="Links" Binding="{Binding Reason}" IsReadOnly="True" Width="1.5*"/>
                            <DataGridTextColumn Header="Modified" Binding="{Binding Modified}" IsReadOnly="True" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
